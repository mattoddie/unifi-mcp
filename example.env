# Copy to .env and fill in:  cp example.env .env
# Every option is explained in docs/configuration.md

# --- UniFi controller -------------------------------------------------------
# URL of the console/controller. UniFi OS consoles (UDM, UCG, UDR, Cloud Key Gen2+):
#   https://192.168.1.1     Legacy self-hosted Network application: https://host:8443
UNIFI_URL=https://192.168.1.1

# Auth: EITHER an API key (UniFi OS only; Settings > Control Plane > Integrations)...
UNIFI_API_KEY=
# ...OR a local admin account (no MFA). Use a "View Only" role if you keep writes disabled.
UNIFI_USERNAME=
UNIFI_PASSWORD=

# Default site name (as used in the API, not the display name). See unifi_list_sites.
UNIFI_SITE=default
# For an https URL the server won't start until you choose how to check the controller's
# certificate: UNIFI_TLS_FINGERPRINT (recommended), UNIFI_CA_FILE or UNIFI_VERIFY_SSL.
# Consoles ship with self-signed certificates, so this example skips the check. That lets
# anyone on the network path impersonate the controller: set UNIFI_TLS_FINGERPRINT below
# and remove this line (or set it to true for a publicly trusted certificate).
UNIFI_VERIFY_SSL=false
# Recommended: pin the controller's certificate by its SHA-256 fingerprint (AA:BB:... or hex),
# so nobody else can impersonate it. Get it with:
#   openssl s_client -connect 192.168.1.1:443 </dev/null 2>/dev/null | openssl x509 -noout -fingerprint -sha256
UNIFI_TLS_FINGERPRINT=
# Or, for a certificate from your own CA: path to the CA's PEM file (turns verification on,
# so remove UNIFI_VERIFY_SSL=false above).
# UNIFI_CA_FILE=/run/secrets/unifi_ca.pem
# auto | unifi-os | legacy
UNIFI_CONTROLLER_TYPE=auto
UNIFI_TIMEOUT_MS=30000

# Register tools that change state (block clients, restart devices, edit config...).
UNIFI_ALLOW_WRITES=false
# Also register tools that delete or forget things (networks, WLANs, rules, clients, vouchers...). Needs writes.
UNIFI_ALLOW_DELETES=false
# Offer include_secrets (unredacted passphrases, keys, passwords) and the WiFi QR tool.
# Off keeps all output redacted, whatever is asked for.
UNIFI_ALLOW_SECRETS=false
# Comma-separated toolsets to expose (default all). Fewer tools = less context for the model;
# see "Keeping the tool list small" in docs/configuration.md for ready-made combinations.
# overview,devices,clients,switching,wifi,networks,firewall,routing,security,vpn,hotspot,monitoring,admin,raw
UNIFI_TOOLSETS=all
# Audit log of every call of a tool that changes things (JSON Lines; off when empty).
# "stderr" writes to the container log; a file path needs a writable directory mounted
# for UID 65532 (see the volumes example in compose.yaml).
UNIFI_AUDIT_LOG=

# --- MCP transport ----------------------------------------------------------
# The image defaults to http. Use stdio for `docker run -i` from an MCP client.
MCP_TRANSPORT=http
MCP_HTTP_PORT=8080
# Required for http (at least 16 characters): clients must send "Authorization: Bearer <token>".
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Only if something in front of the server already authenticates every request
# (then MCP_ALLOWED_HOSTS below is required too):
# MCP_ALLOW_UNAUTHENTICATED=true
# Optional comma-separated allow-list of host names for the Host and Origin headers
# (DNS rebinding and cross-site protection). host or host:port; for Origin, an entry
# without a port only matches the default port (80/443).
MCP_ALLOWED_HOSTS=
