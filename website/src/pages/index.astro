---
import logo from "../../../docs/assets/logo.svg?raw";
import { toolsets, totals } from "../lib/tools";

const GITHUB = "https://github.com/mattoddie/unifi-mcp";
const title = "unifi-mcp: talk to your UniFi network";
const description =
  "An open-source MCP server for Ubiquiti UniFi Network. Ask Claude and other AI assistants about your devices, clients, WiFi and firewall, and let them make changes when you allow it. Runs in Docker.";

const toolsetIcons: Record<string, string> = {
  overview: "🧭",
  devices: "📡",
  clients: "💻",
  switching: "🔀",
  wifi: "📶",
  networks: "🌐",
  firewall: "🧱",
  routing: "🛣️",
  security: "🛡️",
  vpn: "🔐",
  hotspot: "🎟️",
  monitoring: "📈",
  admin: "⚙️",
  raw: "🧪",
};

const examples = [
  { icon: "🩺", q: "Give me a health check of the network.", tools: ["get_site_health", "list_devices", "list_alarms"] },
  { icon: "📶", q: "Which clients have a weak WiFi signal right now?", tools: ["list_clients", "get_device"] },
  { icon: "🔐", q: "Review my port forwards and firewall for anything risky.", tools: ["list_port_forwards", "list_firewall_policies"] },
  { icon: "🔄", q: "Which devices have firmware updates waiting?", tools: ["get_firmware_status", "rolling_upgrade"] },
  { icon: "🎟️", q: "Create 10 one-day guest vouchers limited to 5 Mbps.", tools: ["create_vouchers"] },
  { icon: "🧱", q: "Block 'kids-tablet' until I say otherwise.", tools: ["list_clients", "block_client"] },
];

const controllers = ["UDM / UDM Pro / UDM SE", "Cloud Gateway (UCG)", "Dream Router", "UniFi Express", "Cloud Key Gen2+", "UniFi OS Server", "Self-hosted Network app"];
const clients = ["Claude Code", "Claude Desktop", "VS Code", "Cursor", "Codex", "Any MCP client"];

const composeSnippet = `curl -fsSLO ${GITHUB.replace("github.com", "raw.githubusercontent.com")}/main/compose.yaml
curl -fsSL ${GITHUB.replace("github.com", "raw.githubusercontent.com")}/main/example.env -o .env
# set UNIFI_URL, UNIFI_API_KEY and MCP_AUTH_TOKEN in .env
docker compose up -d`;
const connectSnippet = `claude mcp add --transport http unifi \\
  http://<docker-host>:8080/mcp \\
  --header "Authorization: Bearer <token>"`;

// Wi-Fi arcs for the hero scene: an arc of radius r below (cx, cy), spread degrees either side of straight down.
const arc = (cx: number, cy: number, r: number, spread: number) => {
  const a = (spread * Math.PI) / 180;
  const dx = +(r * Math.sin(a)).toFixed(1);
  const dy = +(r * Math.cos(a)).toFixed(1);
  return `M${cx - dx} ${cy + dy} A${r} ${r} 0 0 0 ${cx + dx} ${cy + dy}`;
};
const ap = { x: 660, y: 670 };
const apArcs = [30, 50, 70, 90].map((r) => arc(ap.x, ap.y, r, 50));
const noiseArcs = [22, 36, 50, 64, 78, 92, 106, 120, 134].map((r, i) => arc(ap.x + (i % 3) * 6 - 6, ap.y, r, 62));
const neighbourArcs = [28, 52, 76, 100, 124].map((r) => arc(1285, 724, r, 72));
---

