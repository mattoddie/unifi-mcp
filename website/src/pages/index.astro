              <stop offset="1" stop-color="#fbbf24" stop-opacity="0" />
            </radialGradient>
          </defs>

          <!-- Ground -->
          <rect x="-10" y="868" width="1440" height="32" fill="#0b0d1c" />

          <!-- The internet, coming in to the gateway -->
          <g class="internet">
            <path d="M74 612 a16 16 0 0 1 22 -20 a22 22 0 0 1 40 6 a14 14 0 0 1 4 28 h-62 a12 12 0 0 1 -4 -14 Z" fill="#1c1f4a" stroke="#818cf8" stroke-width="2" />
            <text x="106" y="652" text-anchor="middle">Internet</text>
            <path class="cable" d="M106 662 V748 H196" />
          </g>

          <!-- Neighbours, also on channel 36 -->
          <g class="neighbour">
            <path d="M1150 704 L1285 634 L1420 704 Z" fill="#121433" stroke="#2a2d62" stroke-width="3" />
            <rect x="1168" y="704" width="234" height="164" fill="#0f1129" />
            <rect x="1196" y="770" width="40" height="34" rx="3" fill="#fbbf24" opacity="0.28" />
            <rect x="1334" y="770" width="40" height="34" rx="3" fill="#fbbf24" opacity="0.18" />
            <g class="n-arcs">{neighbourArcs.map((d) => <path d={d} />)}</g>
            <rect x="1263" y="708" width="44" height="10" rx="5" fill="#9aa0b8" />
            <text x="1285" y="626" text-anchor="middle">Neighbours · ch 36</text>
          </g>

          <!-- The house, cut away -->
          <path d="M140 652 L640 556 L1140 652 Z" fill="url(#roof)" />
          <path d="M140 652 L640 556 L1140 652" fill="none" stroke="#3b3f86" stroke-width="3" />
          <rect x="170" y="652" width="940" height="208" fill="url(#room)" />
          <rect x="164" y="640" width="952" height="12" fill="#2a2d62" />
          <rect x="164" y="640" width="8" height="228" fill="#2a2d62" />
          <rect x="1108" y="640" width="8" height="228" fill="#2a2d62" />
          <rect x="406" y="652" width="8" height="90" fill="#2a2d62" />
          <rect x="164" y="860" width="952" height="8" fill="#2a2d62" />

          <!-- Office: gateway and switch in a cabinet, laptop on a desk -->
          <rect x="188" y="760" width="84" height="100" rx="4" fill="#10122a" stroke="#2f3370" stroke-width="2" />
          <rect x="194" y="734" width="72" height="24" rx="6" fill="#e5e7f3" />
          <circle class="led" cx="254" cy="746" r="3.5" fill="#22d3ee" />
          <rect x="196" y="778" width="68" height="18" rx="3" fill="#d4d7e8" />
          <g class="ports" fill="#34d399">
            <rect x="203" y="785" width="6" height="5" /><rect x="213" y="785" width="6" height="5" /><rect x="223" y="785" width="6" height="5" />
            <rect x="233" y="785" width="6" height="5" /><rect x="243" y="785" width="6" height="5" /><rect x="253" y="785" width="6" height="5" />
          </g>
          <path class="cable" d="M230 758 V778" />
          <path class="cable" d="M196 787 H182 V662 H630" />
          <text x="230" y="724" text-anchor="middle">Gateway</text>
          <text x="230" y="816" text-anchor="middle">Switch</text>
          <rect x="296" y="804" width="104" height="7" rx="2" fill="#2f3370" />
          <rect x="302" y="811" width="6" height="49" fill="#2f3370" /><rect x="388" y="811" width="6" height="49" fill="#2f3370" />
          <rect x="318" y="760" width="62" height="40" rx="4" fill="#1c1f4a" stroke="#c7d2fe" stroke-width="2" />
          <rect x="324" y="766" width="50" height="28" rx="2" fill="#4f46e5" opacity="0.55" />
          <path d="M308 804 H390 L384 798 H314 Z" fill="#c7d2fe" />
          <text x="349" y="848" text-anchor="middle">Laptop</text>

          <!-- Lounge: sofa, lamp, TV -->
          <ellipse cx="560" cy="770" rx="110" ry="80" fill="url(#lamp-glow)" />
          <rect x="606" y="740" width="4" height="120" fill="#2f3370" />
          <path d="M592 742 H624 L616 720 H600 Z" fill="#fcd34d" opacity="0.85" />
          <rect x="440" y="770" width="148" height="42" rx="12" fill="#2b2f6b" />
          <rect x="432" y="800" width="164" height="42" rx="10" fill="#353a80" />
          <rect x="432" y="842" width="10" height="18" fill="#2b2f6b" /><rect x="586" y="842" width="10" height="18" fill="#2b2f6b" />
          <rect x="500" y="768" width="22" height="38" rx="4" fill="#0b0d1c" stroke="#c7d2fe" stroke-width="2" />
          <rect x="504" y="773" width="14" height="27" rx="1.5" fill="#22d3ee" opacity="0.5" />
          <text x="492" y="792" text-anchor="end">Phone</text>

          <rect x="808" y="828" width="144" height="32" rx="4" fill="#23265a" />
          <rect x="800" y="700" width="160" height="92" rx="6" fill="#05060c" stroke="#3b3f86" stroke-width="4" />
          <g class="tv-buffer">
            <circle cx="880" cy="746" r="15" fill="none" stroke="rgba(255,255,255,0.15)" stroke-width="4" />
            <path class="spinner" d="M880 731 a15 15 0 0 1 15 15" fill="none" stroke="#e7e9f3" stroke-width="4" stroke-linecap="round" />
          </g>
          <g class="tv-picture">
            <rect x="806" y="706" width="148" height="80" rx="2" fill="url(#picture)" />
            <circle cx="922" cy="726" r="9" fill="#fde68a" opacity="0.9" />
            <path d="M806 786 V762 L838 740 L866 760 L894 744 L954 776 V786 Z" fill="#1e1b4b" opacity="0.75" />
            <rect x="814" y="764" width="76" height="16" rx="8" fill="rgba(7,8,15,0.75)" />
            <text class="playing" x="852" y="776" text-anchor="middle">▶ playing</text>
          </g>
          <text x="880" y="818" text-anchor="middle">Lounge TV</text>
          <path d="M1040 860 V838 M1040 838 c-18 -6 -22 -28 -12 -40 M1040 838 c16 -8 20 -30 8 -44 M1040 840 c-4 -20 4 -44 2 -60" fill="none" stroke="#2f7a6a" stroke-width="6" stroke-linecap="round" />
          <rect x="1026" y="844" width="28" height="16" rx="3" fill="#2b2f6b" />

          <!-- Wi-Fi links from the access point -->
          <g class="links">
            <path class="link" d="M640 676 L372 758" />
            <path class="link" d="M648 680 L524 766" />
            <path class="link link-tv" d="M680 678 L800 732" />
            <path class="tv-flow" d="M680 678 L800 732" />
          </g>

          <!-- The access point on the lounge ceiling -->
          <ellipse cx={ap.x} cy="700" rx="110" ry="70" fill="url(#ap-glow)" />
          <g class="noise">{noiseArcs.map((d) => <path d={d} />)}</g>
          <g class="arcs">{apArcs.map((d) => <path d={d} />)}</g>
          <rect x="628" y="652" width="64" height="14" rx="7" fill="#eef0f8" />
          <rect class="ap-led" x="644" y="664" width="32" height="4" rx="2" fill="#22d3ee" />
          <text class="ap-name" x="702" y="672">Lounge AP</text>
          <path d="M660 620 V652" stroke="rgba(199,210,254,0.35)" stroke-width="2" stroke-dasharray="3 4" />

          <!-- Channel label -->
          <g class="chan">
            <rect x="530" y="588" width="260" height="32" rx="16" />
            <text class="ch-init" x="660" y="609" text-anchor="middle">5 GHz · ch 36</text>
            <text class="ch-diag" x="660" y="609" text-anchor="middle">5 GHz · ch 36 · 81% busy</text>
            <text class="ch-fixed" x="660" y="609" text-anchor="middle">5 GHz · ch 149 · 9% busy</text>
          </g>

          <!-- The TV's signal -->
          <g class="sig">
            <rect x="806" y="664" width="176" height="28" rx="14" />
            <rect class="b1" x="817" y="682" width="3.5" height="4" rx="1" />
            <rect class="b2" x="822" y="678" width="3.5" height="8" rx="1" />
            <rect class="b3" x="827" y="674" width="3.5" height="12" rx="1" />
            <rect class="b4" x="832" y="670" width="3.5" height="16" rx="1" />
            <text class="sig-diag" x="842" y="683">-78 dBm · 12 Mbps</text>
            <text class="sig-fixed" x="842" y="683">ch 149 · 433 Mbps</text>
          </g>

          <text class="caption" x="640" y="890" text-anchor="middle">Example network</text>
        </svg>

        <div class="wrap hero-grid">
          <div class="hero-copy">
            <p class="eyebrow"><span class="dot"></span> Open source · MIT · Model Context Protocol</p>
            <h1>Talk to your <span class="grad">UniFi network.</span></h1>
            <p class="lede">
              unifi-mcp connects Claude and other AI assistants to your UniFi controller. Ask about devices, clients, WiFi and
              firewall in plain English, and let the assistant make changes when you allow it.
            </p>
            <div class="cta">
              <a class="btn primary" href="/docs/getting-started/">Get started <span aria-hidden="true">→</span></a>
              <a class="btn ghost" href={GITHUB}>Star on GitHub</a>
            </div>
            <div class="pull">
              <code>docker pull ghcr.io/mattoddie/unifi-mcp</code>
              <button class="copy" data-copy="docker pull ghcr.io/mattoddie/unifi-mcp" aria-label="Copy command">Copy</button>
            </div>
          </div>

          <div class="chat" aria-label="Example conversation">
            <div class="chat-bar"><span></span><span></span><span></span><em>Claude · unifi</em></div>
            <div class="chat-body" id="chat">
              <div class="msg user" data-step="0">Why is the lounge TV buffering?</div>
              <div class="calls" data-step="1">
                <span class="call"><i></i>unifi_list_clients<b>search: "tv"</b></span>
                <span class="call"><i></i>unifi_get_device<b>Lounge AP</b></span>
                <span class="call"><i></i>unifi_get_rf_scan<b>5 GHz</b></span>
              </div>
              <div class="msg bot" data-step="2">
                The TV is on <strong>Lounge AP</strong> at <mark>-78 dBm</mark> and only <mark>12 Mbps</mark>. Its 5 GHz channel, 36,
                is <mark>81% busy</mark> and shared with three neighbouring networks.
                <br /><br />Channel 149 is clear. Want me to move the radio there?
              </div>
              <div class="msg user" data-step="3">Yes, go ahead.</div>
              <div class="calls" data-step="4">
                <span class="call write"><i></i>unifi_set_radio<b>na → ch 149</b></span>
              </div>
              <div class="msg bot" data-step="5">Done. Lounge AP is on channel 149 now, and the TV reconnected at <mark>433 Mbps</mark>. ✅</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Stats -->
      <section class="stats wrap" aria-label="At a glance">
        <div><strong>{totals.tools}</strong><span>tools</span></div>
        <div><strong>{totals.toolsets}</strong><span>toolsets</span></div>
        <div><strong>{totals.prompts}</strong><span>guided prompts</span></div>
        <div><strong>1</strong><span>Docker container</span></div>
      </section>

      <!-- Examples -->
      <section class="section wrap">
        <div class="section-head">
          <p class="kicker">Ask anything</p>
          <h2>Your network, in plain English.</h2>
          <p>The assistant picks the right tools, runs them against your controller and explains what it found. No dashboards to dig through.</p>
        </div>
        <div class="examples">
          {
            examples.map((e) => (
              <article class="example">
                <span class="ex-icon" aria-hidden="true">{e.icon}</span>
                <p>“{e.q}”</p>
                <div class="ex-tools">
                  {e.tools.map((t) => (
                    <code>{t}</code>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <!-- Toolsets -->
      <section class="section wrap" id="toolsets">
        <div class="section-head">
          <p class="kicker">Broad coverage</p>
          <h2>{totals.tools} tools across the whole network.</h2>
          <p>
            Grouped into {totals.toolsets} toolsets you can switch on and off, so the assistant only sees what you need:
            {`${totals.read} read, ${totals.write} write and ${totals.delete} delete tools.`}
          </p>
        </div>
        <div class="toolsets">
          {
            toolsets.map((t) => (
              <a class="toolset" href={`/docs/tools/#${t.name}`}>
                <div class="ts-top">
                  <span class="ts-icon" aria-hidden="true">{toolsetIcons[t.name] ?? "🔧"}</span>
                  <code>{t.name}</code>
                  <span class="ts-count">{t.total}</span>
                </div>
                <p>{t.summary}</p>
                <div class="ts-bar" aria-label={`${t.read} read, ${t.write} write, ${t.delete} delete`}>
                  <span class="r" style={`flex:${t.read}`} />
                  <span class="w" style={`flex:${t.write}`} />
                  <span class="d" style={`flex:${t.delete}`} />
                </div>
              </a>
            ))
          }
        </div>
        <p class="legend"><span class="r"></span>read <span class="w"></span>write <span class="d"></span>delete · <a href="/docs/tools/">Full tool reference →</a></p>
      </section>

      <!-- Safety -->
      <section class="section safety-wrap">
        <div class="wrap safety">
          <div class="section-head left">
            <p class="kicker">Safe by default</p>
            <h2>It can look. It only touches when you say so.</h2>
            <p>
              Tools that aren't allowed aren't registered at all. The assistant can't see them, so it can't call them or be talked into
              calling them.
            </p>
            <ul class="checks">
              <li><strong>Read-only out of the box.</strong> Writes and deletes are two separate switches.</li>
              <li><strong>Destructive tools are labelled,</strong> so your client asks before running them.</li>
              <li><strong>Secrets are redacted.</strong> Passphrases and keys never reach the model unless asked for.</li>
              <li><strong>Bearer-token auth</strong>, a Host allow-list and a non-root container.</li>
            </ul>
            <a class="link" href="/docs/security/">Read the security model →</a>
