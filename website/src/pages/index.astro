        codeRepository: GITHUB,
        license: "https://opensource.org/licenses/MIT",
        runtimePlatform: "Docker",
        author: { "@type": "Person", name: "Matt Oddie", url: "https://mattoddie.dev/" },
        isPartOf: { "@type": "WebSite", name: "MCP servers by Matt Oddie", url: "https://mcp.mattoddie.dev/" },
      })}
