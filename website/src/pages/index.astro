            <radialGradient id="sky-glow" cx="0.5" cy="0.5" r="0.5">
              <stop offset="0" stop-color="#6366f1" stop-opacity="0.22" />
              <stop offset="1" stop-color="#6366f1" stop-opacity="0" />
            </radialGradient>
          </defs>
          <rect width="1440" height="900" fill="url(#sky)" />
          <ellipse cx="300" cy="180" rx="520" ry="320" fill="url(#sky-glow)" />
          <ellipse cx="1160" cy="300" rx="420" ry="280" fill="url(#sky-glow)" opacity="0.6" />
          <g class="stars" fill="#e7e9f3">
            <circle cx="120" cy="330" r="1.6" /><circle cx="380" cy="270" r="1.4" /><circle cx="560" cy="380" r="1.8" />
            <circle cx="260" cy="120" r="1.2" /><circle cx="700" cy="90" r="1.3" /><circle cx="900" cy="430" r="1.5" />
            <circle cx="1040" cy="160" r="1.3" /><circle cx="1320" cy="250" r="1.6" />
          </g>
        </svg>
        <svg class="scene-art" viewBox="-10 540 1440 360" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
          <defs>
            <linearGradient id="roof" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#1c1f4a" />
              <stop offset="1" stop-color="#121433" />
            </linearGradient>
            <linearGradient id="room" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#151836" />
              <stop offset="1" stop-color="#1b1e44" />
            </linearGradient>
            <linearGradient id="picture" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#4f46e5" />
              <stop offset="1" stop-color="#06b6d4" />
            </linearGradient>
            <radialGradient id="ap-glow" cx="0.5" cy="0.5" r="0.5">
              <stop offset="0" stop-color="#22d3ee" stop-opacity="0.3" />
              <stop offset="1" stop-color="#22d3ee" stop-opacity="0" />
            </radialGradient>
            <radialGradient id="lamp-glow" cx="0.5" cy="0.5" r="0.5">
