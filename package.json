{
  "name": "unifi-mcp",
  "version": "0.0.0-dev",
  "description": "Model Context Protocol (MCP) server for Ubiquiti UniFi Network: monitor and manage your sites, devices, clients, WiFi and firewall from Claude and other AI assistants",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "unifi",
    "ubiquiti",
    "unifi-network",
    "udm",
    "claude",
    "ai",
    "homelab",
    "networking"
  ],
  "homepage": "https://github.com/mattoddie/unifi-mcp#readme",
  "bugs": {
    "url": "https://github.com/mattoddie/unifi-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattoddie/unifi-mcp.git"
  },
  "license": "MIT",
  "author": "Matt Oddie",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "unifi-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && node --test 'dist/test/*.test.js'",
    "docs:tools": "npm run build && node dist/scripts/gen-tool-docs.js",
    "docs:check": "npm run build && node dist/scripts/gen-tool-docs.js --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "undici": "^8.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
